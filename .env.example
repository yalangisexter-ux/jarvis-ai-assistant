# Public URL of your server-side AI proxy (Cloudflare Worker, Vercel serverless, etc.)
# NEVER put private API keys (OpenAI, Anthropic, Groq, etc.) in VITE_* variables.
# The proxy must hold secrets and enforce rate limits / auth as needed.

VITE_AI_ENDPOINT=https://your-ai-proxy.example.com/chat
VITE_AI_PROVIDER=proxy
